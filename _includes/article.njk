---
layout: default.njk
---
{% include 'breadcrumbs.njk' %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ headline | jsonString | safe }}",
  "description": "{{ description | jsonString | safe }}",
  "author": { "@type": "Organization", "name": "Choice Kitchen Cabinet", "url": "{{ site.url }}" },
  "publisher": { "@type": "Organization", "name": "Choice Kitchen Cabinet", "url": "{{ site.url }}", "logo": { "@type": "ImageObject", "url": "{{ site.url }}/assets/images/choice-logo.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.url }}{{ page.url }}" },
  "datePublished": "{{ datePublished }}",
  "dateModified": "{{ dateModified }}"
}
</script>

<style>
  .guide-hero { background: radial-gradient(900px 380px at 90% -20%, rgba(195,154,102,.3), transparent 60%), linear-gradient(160deg, var(--green), var(--green-deep)); padding: clamp(48px, 8vw, 104px) var(--gutter) clamp(44px, 7vw, 88px); }
  .guide-hero-inner { max-width: 820px; margin: 0 auto; }
  .guide-kicker { text-transform: uppercase; letter-spacing: .18em; font-size: 13px; font-weight: 700; color: var(--gold); margin-bottom: 18px; }
  .guide-hero h1 { color: #fff; font-size: clamp(34px, 5vw, 58px); line-height: 1.08; margin-bottom: 20px; }
  .guide-meta { font-size: 14px; color: rgba(255,255,255,.72); }
  .guide-body { max-width: 760px; margin: 0 auto; padding: clamp(40px, 6vw, 80px) var(--gutter); }
  .guide-body > p:first-child { font-family: var(--serif); font-size: clamp(21px, 2.4vw, 26px); line-height: 1.55; color: var(--charcoal); }
  .guide-body h2 { font-size: clamp(28px, 3.2vw, 38px); margin: 48px 0 16px; padding-top: 28px; border-top: 1px solid var(--line); }
  .guide-body h3 { font-size: 24px; margin: 28px 0 10px; }
  .guide-body p, .guide-body li { font-size: 18px; line-height: 1.85; }
  .guide-body p { margin-bottom: 22px; }
  .guide-body ul, .guide-body ol { margin: 0 0 26px 22px; }
  .guide-body li { margin-bottom: 8px; }
  .guide-body a { color: var(--bronze); font-weight: 600; text-underline-offset: 3px; }
  .guide-body table { width: 100%; border-collapse: collapse; margin: 0 0 30px; font-size: 15.5px; background: #fff; }
  .guide-body th, .guide-body td { text-align: left; padding: 12px 14px; border: 1px solid var(--line); vertical-align: top; line-height: 1.6; }
  .guide-body th { background: var(--green); color: #fff; font-weight: 600; }
  .guide-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -4px; }
  .guide-cta { margin-top: 56px; padding: clamp(28px, 5vw, 48px); text-align: center; border-radius: var(--radius-lg); background: var(--cream); border: 1px solid var(--line); }
  .guide-cta h2 { border: 0; padding: 0; margin: 0 0 14px; font-size: clamp(26px, 3vw, 34px); }
  .guide-cta p { max-width: 560px; margin: 0 auto 24px; }
  .guide-cta .btn-wa { color: #fff; }
</style>
<header class="guide-hero">
  <div class="guide-hero-inner">
    <p class="guide-kicker">{{ kicker }}</p>
    <h1>{{ headline }}</h1>
    <p class="guide-meta">Published by Choice Kitchen Cabinet &bull; Updated {{ updatedLabel }}</p>
  </div>
</header>
<article class="guide-body seo-article-content">
  {{ content | safe }}

  <div class="guide-cta">
    <h2>Planning New Kitchen Cabinets?</h2>
    <p>Send us your kitchen size and preferred materials on WhatsApp and we will discuss options and a quotation with you.</p>
    <a href="{{ site.whatsappUrl }}" class="btn btn-wa" rel="nofollow noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.549 4.107 1.51 5.843L0 24l6.335-1.486A11.95 11.95 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.807 9.807 0 01-5.032-1.383l-.36-.214-3.742.878.9-3.647-.235-.374A9.768 9.768 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
      <span>Chat on WhatsApp</span>
    </a>
  </div>
</article>

{% include 'related-guides.njk' %}
