<!DOCTYPE html>
<html lang="en">
<head>

{% include 'head.njk' %}

<style>
{% include "site.css" %}
</style>

<!-- JSON-LD Structured Data -->
{% if city %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.name }}",
  "description": "{{ description | jsonString | safe }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.streetAddress }}",
    "addressLocality": "{{ site.address.addressLocality }}",
    "addressRegion": "{{ site.address.addressRegion }}",
    "postalCode": "{{ site.address.postalCode }}",
    "addressCountry": "{{ site.address.addressCountry }}"
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ city.name }}"
  },
  "priceRange": "RM4,500 - RM20,000",
  "openingHours": "Mo-Sa 09:00-18:00",
  "image": "{{ site.url }}/assets/images/og-image.png"
}
</script>
{% elif area %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.name }}",
  "description": "{{ description | jsonString | safe }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.streetAddress }}",
    "addressLocality": "{{ site.address.addressLocality }}",
    "addressRegion": "{{ site.address.addressRegion }}",
    "postalCode": "{{ site.address.postalCode }}",
    "addressCountry": "{{ site.address.addressCountry }}"
  },
  "areaServed": [
    {
      "@type": "AdministrativeArea",
      "name": "{{ area.name }}"
    },
    {
      "@type": "City",
      "name": "{{ area.city.name }}"
    }
  ],
  "priceRange": "RM4,500 - RM20,000",
  "openingHours": "Mo-Sa 09:00-18:00",
  "image": "{{ site.url }}/assets/images/og-image.png"
}
</script>
{% else %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.name }}",
  "description": "{{ description | jsonString | safe }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.streetAddress }}",
    "addressLocality": "{{ site.address.addressLocality }}",
    "addressRegion": "{{ site.address.addressRegion }}",
    "postalCode": "{{ site.address.postalCode }}",
    "addressCountry": "{{ site.address.addressCountry }}"
  },
  "areaServed": [
    {% for city in locations.cities %}
    {
      "@type": "City",
      "name": "{{ city.name }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "priceRange": "RM4,500 - RM20,000",
  "openingHours": "Mo-Sa 09:00-18:00",
  "inLanguage": ["en", "ms", "zh", "ta"],
  "image": "{{ site.url }}/assets/images/og-image.png"
}
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}",
  "logo": "{{ site.url }}/assets/images/choice-logo.svg",
  "sameAs": [
    "https://www.facebook.com/mychoicecabinet/",
    "https://www.youtube.com/@mychoicecabinet",
    "https://www.linkedin.com/company/mychoicecabinet/",
    "https://www.tiktok.com/@mychoicecabinet"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "{{ site.phone }}",
    "contactType": "sales",
    "availableLanguage": ["English", "Malay", "Chinese", "Tamil"]
  }
}
</script>

{% if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a kitchen cabinet cost in Malaysia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kitchen cabinets in Malaysia typically range from RM4,500 to RM20,000 depending on kitchen size, materials, and design complexity. We offer competitive pricing with no hidden fees."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer a warranty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! We provide a comprehensive 1-year warranty covering repairs or replacements due to defective parts or workmanship."
      }
    },
    {
      "@type": "Question",
      "name": "What materials do you use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We use high-quality laminate, solid wood, and melamine — selected for durability, aesthetics, and suitability for Malaysia's humid climate."
      }
    },
    {
      "@type": "Question",
      "name": "How long does installation take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most installations are completed within 2 to 7 days, depending on the project size and complexity. Full projects typically take 2-3 weeks from approval."
      }
    }
  ]
}
</script>
{% endif %}

{% if city or area %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    }{% if city %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ city.name }}",
      "item": "{{ site.url }}/{{ city.slug }}/"
    }{% elif area %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ area.city.name }}",
      "item": "{{ site.url }}/{{ area.city.slug }}/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ area.name }}",
      "item": "{{ site.url }}/{{ area.city.slug }}/{{ area.slug }}/"
    }{% endif %}
  ]
}
</script>
{% endif %}

</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

{% include 'header.njk' %}

<main id="main">
{{ content | safe }}
</main>

{% include 'footer.njk' %}

<script>
  let currentLang = 'en';

  function setLang(lang) {
    currentLang = lang;
    document.documentElement.lang = lang === 'bm' ? 'ms' : lang;
    
    document.querySelectorAll('[data-lang]').forEach(el => {
      el.style.display = 'none';
    });
    
    document.querySelectorAll('[data-lang="' + lang + '"]').forEach(el => {
      const isInline = ['SPAN', 'A', 'STRONG', 'EM', 'BUTTON'].includes(el.tagName);
      el.style.display = isInline ? 'inline' : 'block';
    });
    
    document.querySelectorAll('.lang-btn').forEach(btn => {
      const map = { en: 'EN', bm: 'BM', zh: '中文', ta: 'தமிழ்' };
      btn.classList.toggle('active', btn.textContent.trim() === map[lang]);
    });
    
    const url = new URL(window.location);
    url.searchParams.set('lang', lang);
    window.history.replaceState({}, '', url);
  }

  function toggleFaq(btn) {
    const item = btn.closest('.faq-item');
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!wasOpen) item.classList.add('open');
  }

  function openLightbox(src, alt) {
    const modal = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    const caption = document.getElementById('lightbox-caption');
    if (!modal || !img) return;
    img.src = src;
    img.alt = alt || '';
    caption.textContent = alt || '';
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox(event) {
    if (event && event.target && event.target.id !== 'lightbox' && event.target.classList.contains('lightbox-close')) {
      event.stopPropagation();
    }
    const modal = document.getElementById('lightbox');
    if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });

  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const initialLang = urlParams.get('lang') || 'en';
    setLang(initialLang);

    const currentYearSpan = document.getElementById('current-year');
    if (currentYearSpan) {
      currentYearSpan.textContent = new Date().getFullYear();
    }

    document.querySelectorAll('.gallery-item').forEach(function(item) {
      item.style.cursor = 'pointer';
      item.addEventListener('click', function() {
        const img = item.querySelector('img');
        if (img) openLightbox(img.src, img.alt);
      });
    });
  });
</script>
<script src="/js/main.js?v=9"></script>

{% include 'quote-bar.njk' %}

<!-- Lightbox Modal -->
<div id="lightbox" class="lightbox-modal" onclick="closeLightbox(event)">
  <button class="lightbox-close" aria-label="Close" onclick="closeLightbox(event)">&#x2715;</button>
  <img id="lightbox-img" src="" alt="">
  <span id="lightbox-caption" class="lightbox-caption"></span>
</div>

</body>
</html>


