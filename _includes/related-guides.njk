<section class="section related-guides" style="background: var(--warm-white);">
  <div class="section-header">
    <h2 class="section-title">Kitchen Cabinet Guides</h2>
    <p class="section-desc">Practical reading before you plan or order your cabinets.</p>
  </div>
  <ul style="list-style: none; max-width: 860px; margin: 0 auto; padding: 0; display: grid; gap: 12px;">
    {% for g in guides %}{% if g.url != page.url %}
    <li><a href="{{ g.url }}" style="color: var(--copper); font-weight: 600;">{{ g.title }}</a> <span style="color: var(--warm-gray);">&mdash; {{ g.blurb }}</span></li>
    {% endif %}{% endfor %}
  </ul>
  <p style="text-align:center;margin-top:16px;"><a href="/kitchen-cabinet-guides/" style="color: var(--copper);">All guides</a></p>
</section>
